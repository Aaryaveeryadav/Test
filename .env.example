# ============================================================================
# Sahayak Study Platform — environment template
# Copy to `.env.local` for local dev and fill in real values.
# NEVER commit a real .env file. This file contains placeholders only.
# ============================================================================

# --- Supabase (database, auth, storage) -------------------------------------
# Project URL from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Secret (service role) key — SERVER ONLY. Bypasses RLS; never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SECRET-OR-SERVICE-ROLE-KEY

# --- Local model (Ollama) ---------------------------------------------------
# The ONLY AI backend. No hosted/cloud AI provider is used or supported.
# Point this at the machine running Ollama (your RTX 3050 box).
# From the deployed backend, use a private tunnel (e.g. Tailscale/WireGuard
# hostname) — never expose the model server to the public internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Must match the embedding model's output dimension (nomic-embed-text = 768).
# If you change the embedding model, also update chunks.embedding + match_chunks
# (see ARCHITECTURE.md → "Changing the local model").
EMBEDDING_DIM=768
AI_MAX_CONCURRENT=2

# --- Limits & privacy -------------------------------------------------------
TUTOR_DAILY_LIMIT=30
TUTOR_BURST_LIMIT=5
MAX_UPLOAD_MB=25
# Default chat-retention window (days) used when a school has none.
DEFAULT_RETENTION_DAYS=90

# --- Demo seeding (used only by scripts/seed-users.mjs) ---------------------
DEMO_SEED_PASSWORD=ChangeMe-Demo-Only-123
