  "private": true,
  "description": "Secure, multi-school study platform for Class 10 & 12 with grounded local-model AI tutoring (RAG over approved material).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
